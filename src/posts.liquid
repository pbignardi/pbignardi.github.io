---
lang: en
description: Overview of all posts!
title: List of blog posts
eleventyNavigation:
    key: "Posts"
    parent: "Home"

navOptions:
    includeSelf: true
---

{% layout "base.liquid" %}
{% block content %}

<main class="tight-page">
    <section>
        <header>
            <h1>{{ title }}</h1>
        </header>
        <ol class="postlist" reversed start={{ collections.blog_posts.length - 1}}>
            {%- for post in collections.blog_posts | reverse -%}
                <li>{% include "postitem.liquid" %}</li>
            {%- endfor -%}
        </ol>
    </section>
</main>

{% endblock %}
