{% assign navPages = collections.all | eleventyNavigationBreadcrumb: eleventyNavigation.key, navOptions %}

<nav aria-label="Breadcrumb" class="breadcrumb">
    <ol>
    {% for crumb in navPages %}
        <li>
            <a href="{{ crumb.url }}"
                {% if page.url == crumb.url %}
                    aria-current="page"
                {% endif %}> {{crumb.title}} </a>
        </li>
    {% endfor %}
    </ol>
</nav>
