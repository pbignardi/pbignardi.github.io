<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{{ title }}</title>
        <link rel="stylesheet" href="/fonts/fonts.css">
        <link rel="stylesheet" href="/css/index.css">
    </head>
    <body>
        <!-- navbar include -->
        {% include "navbar" %}
        <!-- include breadcrumbs if eleventyNavigation is set -->
        {% if eleventyNavigation != blank %}
        {% include "breadcrumb" %}
        {% endif %}
        <!-- main content -->
        {% block content %}
        {% endblock %}
        <footer>
            {{ author }} - 2026
        </footer>
    </body>
</html>
