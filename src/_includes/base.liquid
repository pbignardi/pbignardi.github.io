<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{{ title }}</title>
        <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/gh/dreampulse/computer-modern-web-font@master/fonts.css">
        <link rel="stylesheet" href="/css/index.css">
        <script src="/js/copycode.js" defer></script>
    </head>
    <body>
        <!-- navbar include -->
        {% include "navbar" %}

        <!-- include breadcrumbs if eleventyNavigation is set -->
        {% if eleventyNavigation != blank %}
        {% include "breadcrumb" %}
        {% endif %}

        <!-- main content -->
        {% block content %}
        {% endblock %}
        <footer>
            {{ author }} - 2026
        </footer>
    </body>
</html>
