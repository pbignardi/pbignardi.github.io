<article class="postitem">
  <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
  <p class="postmeta">
    <time datetime="{{ post.date | date: '%Y-%m-%d' }}">{{ post.date | date: "%d %b %Y" }}</time>
    · {{ post.data.author }}
  </p>
  <p>{{ post.page.excerpt }}</p>
  <p class="tags">
    {% for tag in post.data.tags %}
      {% if tag != "blog_posts" %}
        <a href="/tags/{{ tag | slugify }}/">#{{ tag }}</a>
      {% endif %}
    {% endfor %}
  </p>
</article>
